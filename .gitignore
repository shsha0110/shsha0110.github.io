# --- Quarto Internals ---
/.quarto/
_site/
/_freeze/

# --- Jupyter & Python ---
**/*.quarto_ipynb
.ipynb_checkpoints/
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv
env/
venv/

# --- OS System Files (Mac/Windows) ---
.DS_Store
Thumbs.db

# --- Large Data Files (에러 방지용) ---
# 데이터 파일은 git에 올리지 않는 것이 원칙입니다.
*.csv
*.tsv
*.pkl
*.h5
*.parquet
.quarto/

# --- 원본 자료 (저작권 보호, 로컬 전용) ---
# 강의자료·논문 원본은 포스트 디렉토리에 로컬로만 보관하고 커밋하지 않습니다.
# 정본 파일명은 source.pdf 이지만, 이름을 바꾸기 전에 실수로 커밋되는 것을 막기 위해
# posts/ 아래의 모든 PDF를 확장자 단위로 제외합니다.
posts/**/*.pdf

# --- 비공개 콘텐츠 (절대 커밋 금지) ---
# 공개하지 않을 노트는 이 저장소가 아니라 ~/Developer/causal-private 에 둔다.
# 이 저장소는 public이며, 한 번 커밋하면 이력에 영구히 남아 나중에 지워도
# 회수되지 않는다. 아래는 실수로 여기에 만들어지는 경우를 막는 방어선이다.
posts/**/private/
posts/**/_private/
